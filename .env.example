# Kuchu Puchu mobile app — public, NON-SECRET configuration.
# Every EXPO_PUBLIC_* value is inlined into the app bundle and visible to users.
# Never put API keys, secrets or credentials here.

# Base URL of the backend, including the global /api/v1 prefix.
#   iOS simulator / web:   http://localhost:3000/api/v1
#   Android emulator:      http://10.0.2.2:3000/api/v1
#   Physical device:       http://<your-LAN-IP>:3000/api/v1
#   Staging / production:  https://<host>/api/v1   (HTTPS required)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Must mirror the backend's OTP_LENGTH and OTP_MAX_ATTEMPTS.
EXPO_PUBLIC_OTP_LENGTH=6
EXPO_PUBLIC_OTP_MAX_ATTEMPTS=5

# Public website (Terms, Privacy Policy links). Default: https://kuchupuchu.in
# EXPO_PUBLIC_WEBSITE_URL=https://kuchupuchu.in

# Serve sign-in from the in-app mock (src/api/mocks/auth.ts) until backend M06
# is ready. Code 123456 signs in; anything else is rejected. Never in production.
EXPO_PUBLIC_USE_AUTH_MOCK=false
# selfie | photos | profile | preferences | done — where the mock user lands.
# EXPO_PUBLIC_AUTH_MOCK_NEXT_STEP=done

# Mock selfie decision: approved | review | rejected (review auto-approves after 30 s).
# EXPO_PUBLIC_MOCK_SELFIE_RESULT=approved
# Mock photos auto-approve after 3 s; make the 4th upload stay in review or be rejected: none | review | rejected
# EXPO_PUBLIC_MOCK_PHOTO_EXCEPTION=none

# Mock account status: active | suspended | banned (restricted accounts see only screen 49).
# EXPO_PUBLIC_MOCK_ACCOUNT_STATUS=active
# EXPO_PUBLIC_MOCK_APPEAL_ALLOWED=true

# Mock discovery: empty queue (screen 25) / 409 DISCOVERY_NOT_READY / likes per day before 429.
# EXPO_PUBLIC_MOCK_DISCOVERY_EMPTY=false
# EXPO_PUBLIC_MOCK_DISCOVERY_NOT_READY=false
# EXPO_PUBLIC_MOCK_LIKE_LIMIT=25
# Feature flags
EXPO_PUBLIC_FEATURE_SUPER_LIKE=false
