# Kuchu Puchu mobile app — public, NON-SECRET configuration.
# Every EXPO_PUBLIC_* value is inlined into the app bundle and visible to users.
# Never put API keys, secrets or credentials here.

# Base URL of the backend, including the global /api prefix.
#   iOS simulator / web:   http://localhost:3000/api
#   Android emulator:      http://10.0.2.2:3000/api
#   Physical device:       http://<your-LAN-IP>:3000/api
#   Staging / production:  https://<host>/api   (HTTPS required)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Must mirror the backend's OTP_LENGTH and OTP_MAX_ATTEMPTS.
EXPO_PUBLIC_OTP_LENGTH=6
EXPO_PUBLIC_OTP_MAX_ATTEMPTS=5
