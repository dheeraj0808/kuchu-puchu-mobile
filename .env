# Local development defaults. See .env.example for all options.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_OTP_LENGTH=6
EXPO_PUBLIC_OTP_MAX_ATTEMPTS=5
EXPO_PUBLIC_USE_AUTH_MOCK=true
EXPO_PUBLIC_AUTH_MOCK_NEXT_STEP=done
EXPO_PUBLIC_MOCK_SELFIE_RESULT=approved
EXPO_PUBLIC_MOCK_PHOTO_EXCEPTION=none
EXPO_PUBLIC_MOCK_ACCOUNT_STATUS=active
EXPO_PUBLIC_MOCK_APPEAL_ALLOWED=true
EXPO_PUBLIC_MOCK_DISCOVERY_EMPTY=false
EXPO_PUBLIC_MOCK_DISCOVERY_NOT_READY=false
EXPO_PUBLIC_MOCK_LIKE_LIMIT=25
EXPO_PUBLIC_FEATURE_SUPER_LIKE=false
